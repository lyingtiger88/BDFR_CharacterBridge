// BDFR_CharacterBridge - Daz Studio Body Authoring Tool
// Creates non-rendering muscle / soft-tissue region markers, manages test
// animation clips (Walk / Run / custom), and exports a .bdfrbody.json sidecar
// consumed by BDFR_CharacterBridge in Unreal.
//
// Workflow:
// 1) Select one bone/node for Soft Tissue, or up to two bones for Muscle.
// 2) Run script -> Create Region.
// 3) Move/rotate the created BDFR marker in Daz as needed.
// 4) Assign Walk / Run animation presets or add custom test clips.
// 5) Preview clips while checking the authored regions.
// 6) Export Body Profile.
// 7) Keep the .bdfrbody.json beside the FBX/DTU export.

(function(){

    var TITLE = "BDFR Body Authoring";
    var PROP_PATH = "BDFR/Body Authoring";
    var ROOT_NODE_NAME = "BDFR_BodyAuthoringRoot";
    var CLIPS_PROP_NAME = "BDFR_AnimationClipsJson";

    function safeName(s) {
        s = String(s || "Region");
        s = s.replace(/[^A-Za-z0-9_\-]/g, "_");
        s = s.replace(/_+/g, "_");
        return s;
    }

    function baseName(path) {
        var p = String(path || "").replace(/\\/g, "/");
        var slash = p.lastIndexOf("/");
        return slash >= 0 ? p.substring(slash + 1) : p;
    }

    function addStringProp(node, name, label, value) {
        var p = new DzStringProperty(name, true);
        p.setLabel(label);
        p.setPath(PROP_PATH);
        p.setValue(String(value));
        node.addProperty(p);
        return p;
    }

    function addFloatProp(node, name, label, value, minVal, maxVal) {
        var p = new DzFloatProperty(name, false, true, Number(value));
        p.setLabel(label);
        p.setPath(PROP_PATH);
        p.setMinMax(Number(minVal), Number(maxVal));
        p.setSensitivity(0.01);
        p.setValue(Number(value));
        node.addProperty(p);
        return p;
    }

    function addBoolProp(node, name, label, value) {
        var p = new DzBoolProperty(name, false, true, Boolean(value));
        p.setLabel(label);
        p.setPath(PROP_PATH);
        p.setBoolValue(Boolean(value));
        node.addProperty(p);
        return p;
    }

    function addNodeProp(node, name, label, target) {
        var p = new DzNodeProperty(name, false, true);
        p.setLabel(label);
        p.setPath(PROP_PATH);
        if (target) {
            p.setValue(target);
        }
        node.addProperty(p);
        return p;
    }

    function prop(node, name) {
        return node ? node.findProperty(name) : null;
    }

    function stringProp(node, name, fallback) {
        var p = prop(node, name);
        return p ? String(p.getValue()) : String(fallback || "");
    }

    function floatProp(node, name, fallback) {
        var p = prop(node, name);
        return p ? Number(p.getValue()) : Number(fallback || 0);
    }

    function boolProp(node, name, fallback) {
        var p = prop(node, name);
        return p ? Boolean(p.getBoolValue()) : Boolean(fallback);
    }

    function vec3(v) {
        return [ Number(v.x), Number(v.y), Number(v.z) ];
    }

    function quat(q) {
        return [ Number(q.x), Number(q.y), Number(q.z), Number(q.w) ];
    }

    function topParent(node) {
        var n = node;
        while (n && n.getNodeParent()) {
            n = n.getNodeParent();
        }
        return n;
    }

    function getBDFRMarkers() {
        var out = [];
        var nodes = Scene.getNodeList();
        for (var i = 0; i < nodes.length; i += 1) {
            var n = nodes[i];
            var flag = prop(n, "BDFR_IsBodyRegion");
            if (flag && flag.getBoolValue()) {
                out.push(n);
            }
        }
        return out;
    }

    function getAuthoringRoot(createIfMissing) {
        var nodes = Scene.getNodeList();
        for (var i = 0; i < nodes.length; i += 1) {
            if (nodes[i].name == ROOT_NODE_NAME) {
                return nodes[i];
            }
        }

        if (!createIfMissing) {
            return null;
        }

        var root = new DzNode();
        root.setName(ROOT_NODE_NAME);
        root.setLabel("BDFR Body Authoring Data");
        root.setVisibleInRender(false);
        Scene.addNode(root);

        addBoolProp(root, "BDFR_IsAuthoringRoot", "BDFR Authoring Root", true);
        addStringProp(root, CLIPS_PROP_NAME, "Animation Test Clips", JSON.stringify([
            { name: "Walk", type: "Walk", file: "", loop: true },
            { name: "Run", type: "Run", file: "", loop: true }
        ]));

        return root;
    }

    function defaultClips() {
        return [
            { name: "Walk", type: "Walk", file: "", loop: true },
            { name: "Run", type: "Run", file: "", loop: true }
        ];
    }

    function getAnimationClips() {
        var root = getAuthoringRoot(true);
        var p = prop(root, CLIPS_PROP_NAME);

        if (!p) {
            p = addStringProp(
                root,
                CLIPS_PROP_NAME,
                "Animation Test Clips",
                JSON.stringify(defaultClips())
            );
        }

        var raw = String(p.getValue() || "");
        if (raw.isEmpty()) {
            return defaultClips();
        }

        try {
            var parsed = JSON.parse(raw);
            if (parsed && parsed.length !== undefined) {
                return parsed;
            }
        } catch (e) {
            App.writeToLog("BDFR: Could not parse stored animation clip metadata: " + e);
        }

        return defaultClips();
    }

    function saveAnimationClips(clips) {
        var root = getAuthoringRoot(true);
        var p = prop(root, CLIPS_PROP_NAME);

        if (!p) {
            p = addStringProp(root, CLIPS_PROP_NAME, "Animation Test Clips", "[]");
        }

        p.setValue(JSON.stringify(clips));
        Scene.markChanged();
    }

    function formatClip(clip) {
        var assigned = clip.file && !String(clip.file).isEmpty()
            ? baseName(clip.file)
            : "<not assigned>";

        return "[" + clip.type + "] " + clip.name + "  -  " + assigned;
    }

    function refreshClipList(listBox, clips, preferredIndex) {
        listBox.clear();

        for (var i = 0; i < clips.length; i += 1) {
            listBox.insertItem(formatClip(clips[i]));
        }

        if (clips.length > 0) {
            var index = preferredIndex;
            if (index === undefined || index < 0 || index >= clips.length) {
                index = 0;
            }
            listBox.currentItem = index;
            listBox.setSelected(index, true);
        }
    }

    function chooseAnimationFile(currentPath) {
        var startPath = currentPath && !String(currentPath).isEmpty()
            ? currentPath
            : App.getLoadSavePath();

        return FileDialog.doFileDialog(
            true,
            "Choose Daz Animation / Pose Preset",
            startPath,
            "Daz Animation / Pose (*.duf *.dsf *.dsa *.bvh);;All Files (*)"
        );
    }

    function addAnimationClipDialog(clips) {
        var dlg = new DzBasicDialog();
        dlg.caption = TITLE + " - Add Animation Clip";

        var lblType = new DzLabel(dlg);
        lblType.text = "Clip Type";
        dlg.addWidget(lblType);

        var typeCombo = new DzComboBox(dlg);
        typeCombo.addItems(["Walk", "Run", "Custom"]);
        dlg.addWidget(typeCombo);

        var lblName = new DzLabel(dlg);
        lblName.text = "Clip Name";
        dlg.addWidget(lblName);

        var nameEdit = new DzLineEdit(dlg);
        nameEdit.text = "CustomClip_" + (clips.length + 1);
        dlg.addWidget(nameEdit);

        var lblFile = new DzLabel(dlg);
        lblFile.text = "Animation / Pose Preset File";
        dlg.addWidget(lblFile);

        var fileEdit = new DzLineEdit(dlg);
        fileEdit.readOnly = true;
        fileEdit.placeholderText = "Choose .duf / .dsf / .dsa / .bvh";
        dlg.addWidget(fileEdit);

        var browseBtn = new DzPushButton(dlg);
        browseBtn.text = "Browse...";
        dlg.addWidget(browseBtn);

        browseBtn.clicked.connect(dlg, function(){
            var path = chooseAnimationFile(fileEdit.text);
            if (path && !path.isEmpty()) {
                fileEdit.text = path;
            }
        });

        var loopCheck = new DzCheckBox(dlg);
        loopCheck.text = "Loop during preview";
        loopCheck.checked = true;
        dlg.addWidget(loopCheck);

        if (!dlg.exec()) {
            return -1;
        }

        var clipType = typeCombo.currentText;
        var clipName = String(nameEdit.text || clipType);
        var filePath = String(fileEdit.text || "");

        var clip = {
            name: clipName,
            type: clipType,
            file: filePath,
            loop: Boolean(loopCheck.checked)
        };

        // Replace the initial unassigned Walk/Run slot instead of creating
        // a duplicate when the user assigns those defaults for the first time.
        if (clipType == "Walk" || clipType == "Run") {
            for (var i = 0; i < clips.length; i += 1) {
                if (clips[i].type == clipType &&
                    (!clips[i].file || String(clips[i].file).isEmpty())) {
                    clips[i] = clip;
                    saveAnimationClips(clips);
                    return i;
                }
            }
        }

        clips.push(clip);
        saveAnimationClips(clips);
        return clips.length - 1;
    }

    function removeAnimationClip(clips, index) {
        if (index < 0 || index >= clips.length) {
            return -1;
        }

        var clipName = clips[index].name;
        var answer = MessageBox.question(
            "Remove animation clip '" + clipName + "'?",
            TITLE,
            "&Remove",
            "&Cancel"
        );

        if (answer != 0) {
            return index;
        }

        clips.splice(index, 1);
        saveAnimationClips(clips);

        if (clips.length < 1) {
            return -1;
        }

        return Math.min(index, clips.length - 1);
    }

    function resolvePreviewFigure() {
        var selected = Scene.getPrimarySelection();

        if (!selected) {
            return null;
        }

        var isRegion = prop(selected, "BDFR_IsBodyRegion");
        if (isRegion && isRegion.getBoolValue()) {
            var anchor = prop(selected, "BDFR_AnchorA");
            if (anchor && anchor.getValue()) {
                selected = anchor.getValue();
            }
        }

        if (selected.name == ROOT_NODE_NAME) {
            return null;
        }

        return topParent(selected);
    }

    function applyAnimationClip(clip) {
        if (!clip) {
            return false;
        }

        if (!clip.file || String(clip.file).isEmpty()) {
            MessageBox.warning(
                "No animation file is assigned to '" + clip.name + "'.\n\nUse Add Clip and choose a preset file. If this is the default Walk/Run slot, adding the same type will replace it.",
                TITLE,
                "&OK"
            );
            return false;
        }

        var fileInfo = new DzFileInfo(String(clip.file));
        if (!fileInfo.exists()) {
            MessageBox.warning(
                "Animation file does not exist:\n" + clip.file,
                TITLE,
                "&OK"
            );
            fileInfo.deleteLater();
            return false;
        }
        fileInfo.deleteLater();

        var figure = resolvePreviewFigure();
        if (!figure) {
            MessageBox.warning(
                "Select the character, one of its bones, or a BDFR region marker before applying a test clip.",
                TITLE,
                "&OK"
            );
            return false;
        }

        Scene.pause();
        Scene.selectAllNodes(false);
        figure.select(true);
        Scene.setPrimarySelection(figure);

        var contentMgr = App.getContentMgr();
        if (!contentMgr) {
            MessageBox.critical("Daz Content Manager is unavailable.", TITLE, "&OK");
            return false;
        }

        var loaded = contentMgr.openFile(String(clip.file), true);
        if (!loaded) {
            MessageBox.warning(
                "Daz could not apply the animation preset:\n" + clip.file,
                TITLE,
                "&OK"
            );
            return false;
        }

        Scene.loopPlayback(Boolean(clip.loop));
        Scene.setFrame(0);
        Scene.update();

        return true;
    }

    function playPauseClip(clip) {
        if (Scene.isPlaying()) {
            Scene.pause();
            return;
        }

        if (clip && clip.file && !String(clip.file).isEmpty()) {
            if (!applyAnimationClip(clip)) {
                return;
            }
        }

        Scene.loopPlayback(clip ? Boolean(clip.loop) : true);
        Scene.play(true);
    }

    function createRegionDialog(selectedNodes) {
        if (!selectedNodes || selectedNodes.length < 1) {
            MessageBox.warning(
                "Select at least one bone or node first.\n\nFor a muscle, selecting two bones records Anchor A and Anchor B.",
                TITLE, "&OK");
            return;
        }

        var dlg = new DzBasicDialog();
        dlg.caption = TITLE + " - Create Region";

        var lblSelection = new DzLabel(dlg);
        lblSelection.text = "Selected: " + selectedNodes.length + " node(s)";
        dlg.addWidget(lblSelection);

        var lblType = new DzLabel(dlg);
        lblType.text = "Region Type";
        dlg.addWidget(lblType);

        var typeCombo = new DzComboBox(dlg);
        typeCombo.addItems([
            "Muscle",
            "SoftTissue",
            "FatPad",
            "Breast",
            "Glute",
            "Abdomen",
            "Custom"
        ]);
        dlg.addWidget(typeCombo);

        var lblSide = new DzLabel(dlg);
        lblSide.text = "Side";
        dlg.addWidget(lblSide);

        var sideCombo = new DzComboBox(dlg);
        sideCombo.addItems(["Center", "Left", "Right"]);
        dlg.addWidget(sideCombo);

        var lblName = new DzLabel(dlg);
        lblName.text = "Region Name";
        dlg.addWidget(lblName);

        var nameEdit = new DzLineEdit(dlg);
        nameEdit.text = "Region_" + (getBDFRMarkers().length + 1);
        dlg.addWidget(nameEdit);

        function addNumberField(label, value, minVal, maxVal) {
            var l = new DzLabel(dlg);
            l.text = label;
            dlg.addWidget(l);
            var e = new DzLineEdit(dlg);
            e.text = String(value);
            e.setDoubleValidator(minVal, maxVal, 4, false);
            dlg.addWidget(e);
            return e;
        }

        var radiusX = addNumberField("Radius X (cm)", 5.0, 0.01, 1000.0);
        var radiusY = addNumberField("Radius Y (cm)", 5.0, 0.01, 1000.0);
        var radiusZ = addNumberField("Radius Z (cm)", 5.0, 0.01, 1000.0);
        var massKg = addNumberField("Mass (kg)", 0.25, 0.0, 1000.0);
        var stiffness = addNumberField("Stiffness", 0.65, 0.0, 100.0);
        var damping = addNumberField("Damping", 0.35, 0.0, 100.0);
        var compliance = addNumberField("Compliance", 0.25, 0.0, 100.0);
        var activation = addNumberField("Activation Scale", 1.0, 0.0, 10.0);
        var maxBulge = addNumberField("Max Bulge", 0.12, 0.0, 10.0);
        var collisionScale = addNumberField("Collision Scale", 1.0, 0.01, 10.0);

        if (!dlg.exec()) {
            return;
        }

        var anchorA = Scene.getPrimarySelection() || selectedNodes[0];
        var anchorB = null;

        if (selectedNodes.length > 1) {
            for (var selectedIndex = 0; selectedIndex < selectedNodes.length; selectedIndex += 1) {
                if (selectedNodes[selectedIndex] != anchorA) {
                    anchorB = selectedNodes[selectedIndex];
                    break;
                }
            }
        }

        var marker = new DzNode();
        var regionName = safeName(nameEdit.text);
        var markerName = "BDFR_" + safeName(typeCombo.currentText) + "_" + regionName + "_" + Scene.getNumNodes();

        marker.setName(markerName);
        marker.setLabel("BDFR " + typeCombo.currentText + " - " + nameEdit.text);
        Scene.addNode(marker);

        var posA = anchorA.getWSPos();
        var markerPos = new DzVec3(posA.x, posA.y, posA.z);

        if (anchorB) {
            var posB = anchorB.getWSPos();
            markerPos = new DzVec3(
                (posA.x + posB.x) * 0.5,
                (posA.y + posB.y) * 0.5,
                (posA.z + posB.z) * 0.5
            );
        }

        marker.setWSPos(markerPos);
        marker.setVisibleInRender(false);

        anchorA.addNodeChild(marker, true);

        addBoolProp(marker, "BDFR_IsBodyRegion", "BDFR Body Region", true);
        addStringProp(marker, "BDFR_RegionType", "Region Type", typeCombo.currentText);
        addStringProp(marker, "BDFR_RegionName", "Region Name", nameEdit.text);
        addStringProp(marker, "BDFR_Side", "Side", sideCombo.currentText);
        addNodeProp(marker, "BDFR_AnchorA", "Anchor A", anchorA);
        addNodeProp(marker, "BDFR_AnchorB", "Anchor B", anchorB);
        addStringProp(marker, "BDFR_AnchorAName", "Anchor A Name", anchorA.name);
        addStringProp(marker, "BDFR_AnchorBName", "Anchor B Name", anchorB ? anchorB.name : "");

        addFloatProp(marker, "BDFR_RadiusX", "Radius X (cm)", Number(radiusX.text), 0.01, 1000.0);
        addFloatProp(marker, "BDFR_RadiusY", "Radius Y (cm)", Number(radiusY.text), 0.01, 1000.0);
        addFloatProp(marker, "BDFR_RadiusZ", "Radius Z (cm)", Number(radiusZ.text), 0.01, 1000.0);
        addFloatProp(marker, "BDFR_MassKg", "Mass (kg)", Number(massKg.text), 0.0, 1000.0);
        addFloatProp(marker, "BDFR_Stiffness", "Stiffness", Number(stiffness.text), 0.0, 100.0);
        addFloatProp(marker, "BDFR_Damping", "Damping", Number(damping.text), 0.0, 100.0);
        addFloatProp(marker, "BDFR_Compliance", "Compliance", Number(compliance.text), 0.0, 100.0);
        addFloatProp(marker, "BDFR_ActivationScale", "Activation Scale", Number(activation.text), 0.0, 10.0);
        addFloatProp(marker, "BDFR_MaxBulge", "Max Bulge", Number(maxBulge.text), 0.0, 10.0);
        addFloatProp(marker, "BDFR_CollisionScale", "Collision Scale", Number(collisionScale.text), 0.01, 10.0);

        Scene.selectAllNodes(false);
        marker.select(true);
        Scene.setPrimarySelection(marker);

        MessageBox.information(
            "BDFR region marker created.\n\nMove/rotate the marker with Daz transform tools, then use Walk/Run test clips to inspect its placement during motion.",
            TITLE, "&OK");
    }

    function exportProfile() {
        var markers = getBDFRMarkers();
        if (markers.length < 1) {
            MessageBox.warning("No BDFR body region markers were found in the scene.", TITLE, "&OK");
            return;
        }

        var regions = [];
        var characterRoot = null;

        for (var i = 0; i < markers.length; i += 1) {
            var marker = markers[i];
            var anchorAProp = prop(marker, "BDFR_AnchorA");
            var anchorBProp = prop(marker, "BDFR_AnchorB");
            var anchorA = anchorAProp ? anchorAProp.getValue() : null;
            var anchorB = anchorBProp ? anchorBProp.getValue() : null;

            if (!characterRoot && anchorA) {
                characterRoot = topParent(anchorA);
            }

            var localPos = marker.getLocalPos();
            var localRot = marker.getLocalRot();
            var worldPos = marker.getWSPos();
            var worldRot = marker.getWSRot();

            regions.push({
                id: marker.name,
                label: marker.getLabel(),
                name: stringProp(marker, "BDFR_RegionName", marker.getLabel()),
                type: stringProp(marker, "BDFR_RegionType", "Custom"),
                side: stringProp(marker, "BDFR_Side", "Center"),
                anchorA: anchorA ? anchorA.name : stringProp(marker, "BDFR_AnchorAName", ""),
                anchorB: anchorB ? anchorB.name : stringProp(marker, "BDFR_AnchorBName", ""),
                localPosition: vec3(localPos),
                localRotation: quat(localRot),
                worldPosition: vec3(worldPos),
                worldRotation: quat(worldRot),
                radiusCm: [
                    floatProp(marker, "BDFR_RadiusX", 5.0),
                    floatProp(marker, "BDFR_RadiusY", 5.0),
                    floatProp(marker, "BDFR_RadiusZ", 5.0)
                ],
                massKg: floatProp(marker, "BDFR_MassKg", 0.25),
                stiffness: floatProp(marker, "BDFR_Stiffness", 0.65),
                damping: floatProp(marker, "BDFR_Damping", 0.35),
                compliance: floatProp(marker, "BDFR_Compliance", 0.25),
                activationScale: floatProp(marker, "BDFR_ActivationScale", 1.0),
                maxBulge: floatProp(marker, "BDFR_MaxBulge", 0.12),
                collisionScale: floatProp(marker, "BDFR_CollisionScale", 1.0),
                enabled: true
            });
        }

        var clips = getAnimationClips();
        var exportedClips = [];

        for (var clipIndex = 0; clipIndex < clips.length; clipIndex += 1) {
            exportedClips.push({
                name: String(clips[clipIndex].name || ("Clip_" + clipIndex)),
                type: String(clips[clipIndex].type || "Custom"),
                sourceFile: String(clips[clipIndex].file || ""),
                loop: clips[clipIndex].loop === undefined
                    ? true
                    : Boolean(clips[clipIndex].loop)
            });
        }

        var profile = {
            schema: "BDFR.BodyProfile",
            version: 2,
            units: "cm",
            coordinateSystem: "DazStudio",
            characterName: characterRoot ? characterRoot.name : "",
            characterLabel: characterRoot ? characterRoot.getLabel() : "",
            animationClips: exportedClips,
            regions: regions
        };

        var startPath = App.getLoadSavePath();
        var filePath = FileDialog.doFileDialog(
            false,
            "Export BDFR Body Profile",
            startPath,
            "BDFR Body Profile (*.bdfrbody.json)"
        );

        if (filePath.isEmpty()) {
            return;
        }

        if (filePath.toLowerCase().right(14) != ".bdfrbody.json") {
            filePath += ".bdfrbody.json";
        }

        var f = new DzFile(filePath);
        if (!f.open(DzFile.WriteOnly | DzFile.Truncate)) {
            MessageBox.critical("Could not open file for writing:\n" + filePath, TITLE, "&OK");
            f.deleteLater();
            return;
        }

        var jsonText = JSON.stringify(profile, null, 2);
        if (typeof(f.writeUtf8) == "function") {
            f.writeUtf8(jsonText);
        } else {
            f.write(jsonText);
        }
        f.close();
        f.deleteLater();

        var fi = new DzFileInfo(filePath);
        App.setLoadSavePath(fi.path());
        fi.deleteLater();

        MessageBox.information(
            "Exported " + regions.length + " BDFR body region(s) and " +
            exportedClips.length + " animation test clip(s):\n" + filePath +
            "\n\nPlace this file beside the FBX/DTU. CharacterBridge can auto-detect it during import.",
            TITLE, "&OK");
    }

    function mainDialog() {
        var clips = getAnimationClips();

        var dlg = new DzBasicDialog();
        dlg.caption = TITLE;

        var info = new DzLabel(dlg);
        info.text =
            "Author muscle and soft-tissue regions for Unreal.\n" +
            "Use Walk/Run test clips to inspect placement while the character moves.";
        dlg.addWidget(info);

        var actionLabel = new DzLabel(dlg);
        actionLabel.text = "Body Authoring";
        dlg.addWidget(actionLabel);

        var actionCombo = new DzComboBox(dlg);
        actionCombo.addItem("Create Region");
        actionCombo.addItem("Export Body Profile");
        dlg.addWidget(actionCombo);

        var clipsLabel = new DzLabel(dlg);
        clipsLabel.text = "Animation Test Clips";
        dlg.addWidget(clipsLabel);

        var clipList = new DzListBox(dlg);
        clipList.selectionMode = DzListBox.Single;
        dlg.addWidget(clipList);

        refreshClipList(clipList, clips, 0);

        var addBtn = new DzPushButton(dlg);
        addBtn.text = "Add Clip";
        dlg.addWidget(addBtn);

        var removeBtn = new DzPushButton(dlg);
        removeBtn.text = "Remove Clip";
        dlg.addWidget(removeBtn);

        var applyBtn = new DzPushButton(dlg);
        applyBtn.text = "Apply Selected Clip";
        dlg.addWidget(applyBtn);

        var playPauseBtn = new DzPushButton(dlg);
        playPauseBtn.text = "Play / Pause Preview";
        dlg.addWidget(playPauseBtn);

        addBtn.clicked.connect(dlg, function(){
            var newIndex = addAnimationClipDialog(clips);
            if (newIndex >= 0) {
                refreshClipList(clipList, clips, newIndex);
            }
        });

        removeBtn.clicked.connect(dlg, function(){
            var index = clipList.currentItem;
            var nextIndex = removeAnimationClip(clips, index);
            refreshClipList(clipList, clips, nextIndex);
        });

        applyBtn.clicked.connect(dlg, function(){
            var index = clipList.currentItem;
            if (index >= 0 && index < clips.length) {
                applyAnimationClip(clips[index]);
            }
        });

        playPauseBtn.clicked.connect(dlg, function(){
            var index = clipList.currentItem;
            var clip = (index >= 0 && index < clips.length)
                ? clips[index]
                : null;
            playPauseClip(clip);
        });

        if (!dlg.exec()) {
            Scene.pause();
            return;
        }

        Scene.pause();

        if (actionCombo.currentItem == 0) {
            createRegionDialog(Scene.getSelectedNodeList());
        } else {
            exportProfile();
        }
    }

    mainDialog();

})();